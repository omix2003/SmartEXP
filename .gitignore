# pyenv
#   For a library or app, you might want to share your .python-version if you
#   use pyenv and local version file (.python-version) should be shared
# .python-version

# pipenv
#   According to pypa/pipenv#1197, it is determined that Pipfile.lock should be factored into version control.
#   However, in case of collaboration, if delegates have different models, they could conflict.
# Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock can be either shared or ignored.
#   Refer to: https://python-poetry.org/docs/basic-usage/#commit-your-poetrylock-file-to-version-control
# poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock can be either shared or ignored.
# pdm.lock
#   pdm persistent configuration
.pdm-python
.pdm-build/

